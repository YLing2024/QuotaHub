# QuotaHub server 环境变量示例 (复制为 .env 或由 systemd/export 注入)

# 服务端口 (默认 3000)
PORT=3000
# 绑定地址 (默认仅本机 127.0.0.1; 局域网访问设 0.0.0.0 并建议配置 QUOTAHUB_TOKEN)
HOST=127.0.0.1

# 可选应用层鉴权: 设置后 /api/* 需要 Authorization: Bearer <token> 或 X-Quotahub-Token / X-Auth-Token 头
QUOTAHUB_TOKEN=

# 数据目录 (JSON 配置 + monitor.db SQLite 监控数据)
QUOTAHUB_DATA_DIR=./data

# 静态前端目录覆盖 (默认自动向上查找 public/)
# QUOTAHUB_STATIC_DIR=../public

# 沙箱脚本执行时长上限 ms (100~30000, 默认 2000)
QUOTAHUB_SCRIPT_TIMEOUT_MS=2000

# =1 允许抓取内网/环回地址 (SSRF 防护例外, 用于监控内网平台)
QUOTAHUB_ALLOW_PRIVATE=

# QuotaHub server 环境变量示例 (复制为 .env 或由 systemd/export 注入)

# 服务端口 (默认 3000)
PORT=3000
# 绑定地址 (默认仅本机 127.0.0.1; 局域网访问设 0.0.0.0 并建议配置 QUOTAHUB_TOKEN)
HOST=127.0.0.1

# 可选应用层鉴权: 设置后 /api/* 需要 Authorization: Bearer <token> 或 X-Quotahub-Token / X-Auth-Token 头
QUOTAHUB_TOKEN=

# 数据目录 (JSON 配置 + monitor.db SQLite 监控数据)
QUOTAHUB_DATA_DIR=./data

# 静态前端目录覆盖 (默认自动向上查找 public/)
# QUOTAHUB_STATIC_DIR=../public

# 沙箱脚本执行时长上限 ms (100~30000, 默认 2000)
QUOTAHUB_SCRIPT_TIMEOUT_MS=2000

# =1 允许抓取内网/环回地址 (SSRF 防护例外, 用于监控内网平台)
QUOTAHUB_ALLOW_PRIVATE=

# ---- BFF SSO (标准 OAuth2, token 只留服务端; 私有地址一律走这里, 勿写进源码) ----
# 认证中心 issuer (授权/令牌/用户信息/撤销端点所在前缀); 生产必须覆盖为真实认证中心
QUOTAHUB_SSO_ISSUER=https://auth.example.com
# 注册的 client_id
QUOTAHUB_SSO_CLIENT_ID=quotahub
# 回调地址; 留空则按请求 Host/X-Forwarded-Proto 推导。生产建议显式固定, 且与认证中心注册值逐字符一致
# QUOTAHUB_SSO_REDIRECT_URI=https://<你的域名>/sso/callback
# client_secret 文件 (0600) 与键名; 只读, 不打印、不提交
QUOTAHUB_SSO_CLIENT_SECRET_FILE=/root/.sso_clients.env
QUOTAHUB_SSO_CLIENT_SECRET_KEY=QUOTAHUB_CLIENT_SECRET
# 会话 cookie 名 (__Host- 前缀要求 Secure + Path=/ + 无 Domain, 不要改)
QUOTAHUB_SSO_COOKIE_NAME=__Host-quotahub_session
